---
/*
  The compact eye — nav mark, CTA eyebrow, sample-card seal. Aperture (vesica) +
  ring in brass (identity), a filled iris core in --watch (the one status-true
  element). The core carries data-oju-iris so the persistent-eye controller can
  retint it at defined checkpoints; it defaults to --watch and stays there.

  Colours come through inline `style` (CSS custom properties resolve reliably
  there), not `fill="var(--x)"` presentation attributes.
*/
interface Props {
  width?: number;
  class?: string;
  iris?: string;
  stroke?: number;
  id?: string;
}

const { width = 34, class: cls, iris = 'var(--watch)', stroke = 3, id } = Astro.props;
const height = Math.round((width * 44) / 64);
---

<svg
  id={id}
  width={width}
  height={height}
  viewBox="0 0 64 44"
  class={cls}
  fill="none"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M3 22 A33 33 0 0 1 61 22 A33 33 0 0 1 3 22 Z"
    stroke-width={stroke}
    style="stroke:var(--brass)"></path>
  <circle cx="32" cy="22" r="10.5" stroke-width={stroke} style="stroke:var(--brass)"></circle>
  <circle cx="32" cy="22" r="4.5" data-oju-iris style={`fill:${iris};transition:fill .5s ease`}
  ></circle>
</svg>
