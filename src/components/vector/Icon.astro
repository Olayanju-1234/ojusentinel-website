---
/*
  The icon set — words made from the five primitives (aperture arc, ring, core,
  scan line, node) under the angle rules. Stroke 2 on a 32-grid, butt caps, only
  the core is ever filled. Everything is currentColor so a caller inks it with a
  semantic token; nothing branches on theme.
*/
export type IconName =
  | 'detect'
  | 'verify'
  | 'report'
  | 'protect'
  | 'catalogue'
  | 'sources'
  | 'fingerprint'
  | 'sweep'
  | 'alert';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, size = 32, class: cls, label, strokeWidth = 2 } = Astro.props;

const PATHS: Record<IconName, string> = {
  detect: `
    <path d="M2 16 A17 17 0 0 1 30 16 A17 17 0 0 1 2 16 Z" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <path d="M16 5 A11 11 0 0 1 27 16" fill="none" stroke="currentColor" stroke-width="${strokeWidth}" opacity=".45"/>
    <circle cx="16" cy="16" r="3" fill="currentColor"/>`,
  verify: `
    <circle cx="11" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="21" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="16" cy="16" r="3" fill="currentColor"/>`,
  report: `
    <path d="M3 18 A15.5 15.5 0 0 1 29 18" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="16" cy="18" r="3" fill="currentColor"/>
    <line x1="18.5" y1="15.5" x2="26" y2="8" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="27.5" cy="6.5" r="2.5" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>`,
  protect: `
    <path d="M16 2 A17 17 0 0 1 16 30 A17 17 0 0 1 16 2 Z" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="16" cy="16" r="3" fill="currentColor"/>`,
  catalogue: `
    <circle cx="8" cy="8" r="4.5" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="8" cy="8" r="1.5" fill="currentColor"/>
    <line x1="14" y1="8" x2="28" y2="8" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="8" cy="20" r="4.5" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <line x1="14" y1="20" x2="28" y2="20" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <line x1="4" y1="28.5" x2="22" y2="28.5" stroke="currentColor" stroke-width="${strokeWidth}" opacity=".45"/>`,
  sources: `
    <circle cx="7" cy="9" r="4" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="25" cy="7" r="4" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="16" cy="24" r="4" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="16" cy="24" r="1.5" fill="currentColor"/>
    <path d="M10.5 11.5 L13.5 20.5" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <path d="M22 10.5 L18.5 20.5" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <path d="M11 8.2 L21 7.4" stroke="currentColor" stroke-width="${strokeWidth}" opacity=".45"/>`,
  fingerprint: `
    <line x1="4" y1="12" x2="4" y2="20" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <line x1="9" y1="8" x2="9" y2="24" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <line x1="14" y1="13" x2="14" y2="19" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <line x1="19" y1="5" x2="19" y2="27" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <line x1="24" y1="11" x2="24" y2="21" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="29" cy="16" r="2.5" fill="currentColor"/>`,
  sweep: `
    <path d="M4 16 A12 12 0 0 1 28 16" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <path d="M9 16 A7 7 0 0 1 23 16" fill="none" stroke="currentColor" stroke-width="${strokeWidth}" opacity=".6"/>
    <circle cx="16" cy="16" r="2.5" fill="currentColor"/>
    <line x1="16" y1="16" x2="26" y2="6" stroke="currentColor" stroke-width="${strokeWidth}" opacity=".45"/>`,
  alert: `
    <path d="M2 16 A17 17 0 0 1 30 16 A17 17 0 0 1 2 16 Z" fill="none" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <line x1="16" y1="12" x2="16" y2="17" stroke="currentColor" stroke-width="${strokeWidth}"/>
    <circle cx="16" cy="20.5" r="1.5" fill="currentColor"/>`,
};

const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true', focusable: 'false' };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  class={cls}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  {...a11y}
  set:html={PATHS[name]}
/>
