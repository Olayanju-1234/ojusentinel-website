---
import EyeMark from './vector/EyeMark.astro';

const links = [
  { href: '#problem', label: 'THE PROBLEM' },
  { href: '#how', label: 'HOW IT WORKS' },
  { href: '#who', label: "WHO IT'S FOR" },
];
---

<nav
  class="fixed inset-x-0 top-0 z-50 border-b border-line"
  style="background:var(--nav-bg);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);"
  aria-label="Primary"
>
  <div class="mx-auto flex h-16 max-w-[1200px] items-center gap-4 px-5 sm:gap-6 sm:px-8">
    <a href="#top" class="flex items-center gap-2.5" aria-label="OjuSentinel — home">
      <EyeMark width={34} class="oju-nav-eye" />
      <span class="font-display text-[15px] font-extrabold tracking-[0.03em] text-ink">
        <span style="color:var(--brass)">OJU</span>SENTINEL
      </span>
    </a>

    <div class="ml-auto flex items-center gap-1 font-mono text-xs tracking-[0.08em]">
      <div class="hidden items-center gap-1 md:flex">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="rounded-lg px-3 py-2 whitespace-nowrap text-ink2 transition-colors hover:bg-s1 hover:text-ink"
            >
              {l.label}
            </a>
          ))
        }
      </div>

      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle light or dark theme"
        aria-pressed="false"
        class="mx-1 grid h-9 w-9 shrink-0 place-items-center rounded-[9px] border border-line2 text-ink2 transition-colors hover:border-ink2 hover:text-ink sm:mx-1.5"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M8 2 A6 6 0 0 1 8 14 Z" fill="currentColor"></path>
        </svg>
      </button>

      <a
        href="#cta"
        class="shrink-0 rounded-[9px] px-3.5 py-2.5 font-body text-[12.5px] font-semibold whitespace-nowrap sm:px-4.5"
        style="background:var(--action);color:var(--action-ink)"
      >
        Get the free report
      </a>
    </div>
  </div>
</nav>
