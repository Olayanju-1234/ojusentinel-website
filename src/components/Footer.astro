---
import EyeMark from './vector/EyeMark.astro';
---

<footer class="border-t border-line bg-s0">
  <div
    class="mx-auto flex max-w-[1200px] flex-wrap items-center gap-x-6 gap-y-2.5 px-5 py-[34px] sm:px-8"
  >
    <span class="flex items-center gap-2 font-display text-[13px] font-extrabold text-ink">
      <EyeMark width={26} />
      <span><span style="color:var(--brass)">OJU</span>SENTINEL</span>
    </span>
    <span class="font-mono text-[11.5px] text-mut"
      >ANTI-PIRACY INTELLIGENCE FOR MUSIC &amp; FILM</span
    >
    <a
      href="/privacy"
      class="font-mono text-[11.5px] text-mut underline-offset-4 transition-colors hover:text-ink hover:underline"
      >PRIVACY</a
    >
    <span class="ml-auto font-mono text-[11.5px] text-mut">
      ALL PRODUCT SCENES &amp; TELEMETRY ON THIS PAGE ARE ILLUSTRATIVE
    </span>
  </div>
</footer>
